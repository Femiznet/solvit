# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solvit-db"

# Session/auth secret (min 32 chars in production)
AUTH_SECRET="dev-only-insecure-secret-change-me-min-32-chars-long!!"

# Optional: seed an admin user on `npm run db:seed`
# If both are set, the seeder upserts a user with these credentials and role=admin.
# The user can log in at /api/auth/login with email + password.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Optional: dev password for seeded demo users (default: "password123 (dev only)")
# Only affects demo users - never touch in production. Set to something random to lock them out.
SEED_USER_PASSWORD=""
