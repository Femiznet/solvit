# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Ignore all .env files first, then whitelist .env.example as a tracked template.
.env*
!.env.example

# local env files
.env*.local
.env

# Seed script output logs (ignore generated logs, keep the seeder)
src/scripts/*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

src/scripts/*.log
SUGGESTION.md

logs/

# Serena agent internal cache and memory indexes
.serena/
.clinerules/

# Local-only security backlog (never commit, never push)
SECURITY-TODO.md